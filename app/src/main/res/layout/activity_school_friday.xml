        </LinearLayout>


        <Button
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next Day"
            android:textSize="20sp"
            android:backgroundTint="#FAB7D0"/>
    </LinearLayout>
</ScrollView>
