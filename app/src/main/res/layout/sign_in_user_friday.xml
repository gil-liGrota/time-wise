<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Friday"
            android:textSize="24dp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <!-- שעות יעילות -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Efficiency Time"
            android:textSize="20dp"
            android:background="#FAB7D0"
            android:padding="4dp"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/EffStartH"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Start Time"
                android:textSize="16sp"
                android:focusable="false"
                android:clickable="true"/>

            <EditText
                android:id="@+id/EffEndH"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="End Time"
                android:textSize="16sp"
                android:focusable="false"
                android:clickable="true"/>
        </LinearLayout>

        <!-- שעות לא יעילות -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unefficiency Time"
            android:textSize="20dp"
            android:background="#FAB7D0"
            android:padding="4dp"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/UneffStartH"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Start Time"
                android:textSize="16sp"
                android:focusable="false"
                android:clickable="true"/>

            <EditText
                android:id="@+id/UneffEndH"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="End Time"
                android:textSize="16sp"
                android:focusable="false"
                android:clickable="true"/>
        </LinearLayout>

        <!-- שעות שינה -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sleep Time"
            android:textSize="20dp"
            android:background="#FAB7D0"
            android:padding="4dp"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/SleepStartH"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Start Time"
                android:textSize="16sp"
                android:focusable="false"
                android:clickable="true"/>

            <EditText
                android:id="@+id/SleepEndH"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="End Time"
                android:textSize="16sp"
                android:focusable="false"
                android:clickable="true"/>
        </LinearLayout>

        <!-- כפתור למעבר ליום הבא -->
        <Button
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next Day"
            android:textSize="20sp"
            android:backgroundTint="#FAB7D0"/>

    </LinearLayout>
</ScrollView>
