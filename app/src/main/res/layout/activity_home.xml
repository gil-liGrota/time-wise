<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#FFEAF0"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☰"
            android:textSize="28sp"
            android:textColor="#FAB7D0"
            android:padding="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textColor="#FAB7D0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginLeft="120dp"
            android:paddingStart="16dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/sideMenu"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFEAF0"
            android:padding="8dp"
            android:visibility="gone">
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FAB7D0"
                android:layout_margin="8dp"/>
            <TextView
                android:id="@+id/nav_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏠 Home"
                android:textStyle="bold"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#FAB7D0"/>

            <TextView
                android:id="@+id/nav_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 Activity"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_school_schedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📚 School Schedule"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_follow_efficiency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📈 Follow Efficiency"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_todo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅ TODO"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅 Calendar"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 Notes"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_follow_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎯 Follow Goal"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FAB7D0"
                android:layout_margin="8dp"/>

            <TextView
                android:id="@+id/nav_sign_out"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SIGN OUT"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#FF5252"
                android:textStyle="bold"
                android:layout_marginBottom="0dp"
                android:gravity="center_horizontal"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="#FFEAF0"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvUsernameDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="username: "
                android:textSize="20sp"
                android:textColor="#000000"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tvPhoneDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="phone number: "
                android:textSize="20sp"
                android:textColor="#000000"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="change notification time:"
                android:textSize="20sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/tvNotificationTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17:00"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#FAB7D0"
                android:padding="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
