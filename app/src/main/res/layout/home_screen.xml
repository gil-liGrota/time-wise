<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toolbar עם כפתור המבורגר -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#FAB7D0"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☰"
            android:textSize="28sp"
            android:textColor="@android:color/white"
            android:padding="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:paddingStart="16dp"/>
    </LinearLayout>

    <!-- תוכן + תפריט -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- תפריט צד שמאל -->
        <LinearLayout
            android:id="@+id/sideMenu"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFEAF0"
            android:padding="8dp"
            android:visibility="gone">
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FAB7D0"
                android:layout_margin="8dp"/>
            <TextView
                android:id="@+id/nav_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏠 Home"
                android:textStyle="bold"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#FAB7D0"/>

            <TextView
                android:id="@+id/nav_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 Activity"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_school_schedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📚 School Schedule"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_follow_efficiency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📈 Follow Efficiency"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_todo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅ TODO"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅 Calendar"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 Notes"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_learning_plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎓 Learning Plan"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_follow_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎯 Follow Goal"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>
        </LinearLayout>

        <!-- תוכן מרכזי -->
        <LinearLayout
            android:layout_width="1dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:id="@+id/tvWelcome"
                android:text="welcome"
                android:textSize="48dp"
                android:textStyle="bold"
                android:textColor="#000000"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
