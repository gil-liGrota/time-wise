<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:id="@+id/rootLayout"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:background="#FFEAF0"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/btnMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="☰"
        android:textSize="28sp"
        android:textColor="#FAB7D0"
        android:padding="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Learning Plan"
        android:textColor="#FAB7D0"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginLeft="85dp"
        android:paddingStart="16dp"/>
</LinearLayout>

<LinearLayout
    android:id="@+id/contentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/sideMenu"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFEAF0"
        android:padding="8dp"
        android:visibility="gone">
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FAB7D0"
            android:layout_margin="8dp"/>
        <TextView
            android:id="@+id/nav_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏠 Home"
            android:textStyle="bold"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#FAB7D0"/>

        <TextView
            android:id="@+id/nav_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Activity"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/nav_school_schedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📚 School Schedule"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/nav_follow_efficiency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📈 Follow Efficiency"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/nav_todo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ TODO"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/nav_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 Calendar"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/nav_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 Notes"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/nav_learning_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎓 Learning Plan"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/nav_follow_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎯 Follow Goal"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#333333"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FAB7D0"
            android:layout_margin="8dp"/>

        <TextView
            android:id="@+id/nav_sign_out"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SIGN OUT"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#FF5252"
            android:textStyle="bold"
            android:layout_marginBottom="0dp"
            android:gravity="center_horizontal"/>
    </LinearLayout>

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:background="#FFEAF0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create Study Plan"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="20dp"
                android:textColor="#FAB7D0"/>

            <!-- Test Details -->
            <EditText
                android:id="@+id/etTargetDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Test Date (DD/MM/YYYY)"
                android:inputType="date" />

            <EditText
                android:id="@+id/etTotalHours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Total study hours needed"
                android:inputType="number" />

            <EditText
                android:id="@+id/etMaxDailyHours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Max study hours per day"
                android:inputType="number" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginVertical="16dp"/>

            <!-- Add Topics Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Topics:"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etTopicName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:hint="Topic Name" />

                <Spinner
                    android:id="@+id/spDifficulty"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnAddTopic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:backgroundTint="#FAB7D0"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- List of added topics -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTopics"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginVertical="8dp"
                android:background="#FFEAF0"
                android:elevation="2dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginVertical="16dp"/>

            <!-- Constraints Section -->
            <Switch
                android:id="@+id/swSchoolGaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Include school windows/gaps?"
                android:padding="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etExcludeDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Blocked Date (DD/MM/YYYY)" />

                <Button
                    android:id="@+id/btnAddExcludeDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FAB7D0"
                    android:text="Block" />
            </LinearLayout>

            <!-- Final Action Button -->
            <Button
                android:id="@+id/btnGeneratePlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Generate Study Plan"
                android:layout_marginTop="24dp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#333333"
                android:padding="12dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
</LinearLayout>
