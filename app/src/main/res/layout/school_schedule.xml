<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:background="#FFEAF0"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#FFEAF0"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☰"
            android:textSize="28sp"
            android:textColor="#FAB7D0"
            android:padding="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="School Schedule"
            android:textColor="#FAB7D0"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginLeft="75dp"
            android:paddingStart="16dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/sideMenu"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFEAF0"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/nav_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏠 Home"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 Activity"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FAB7D0"
                android:layout_margin="8dp"/>

            <TextView
                android:id="@+id/nav_school_schedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📚 School Schedule"
                android:textStyle="bold"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#FAB7D0"/>

            <TextView
                android:id="@+id/nav_follow_efficiency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📈 Follow Efficiency"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_todo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅ TODO"
                android:padding="12dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅 Calendar"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 Notes"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_learning_plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎓 Learning Plan"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_follow_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎯 Follow Goal"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FAB7D0"
                android:layout_margin="8dp"/>

            <TextView
                android:id="@+id/nav_sign_out"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SIGN OUT"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#FF5252"
                android:textStyle="bold"
                android:layout_marginBottom="0dp"
                android:gravity="center_horizontal"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="6"
                android:padding="8dp"
                android:gravity="center">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSun"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="Sun"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FAB7D0"
                    style="@style/Widget.AppCompat.Button.Colored"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnMon"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="Mon"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FAB7D0"
                    style="@style/Widget.AppCompat.Button.Colored"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTue"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="Tue"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FAB7D0"
                    style="@style/Widget.AppCompat.Button.Colored"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnWed"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="Wed"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FAB7D0"
                    style="@style/Widget.AppCompat.Button.Colored"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnThu"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="Thu"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FAB7D0"
                    style="@style/Widget.AppCompat.Button.Colored"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnFri"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="Fri"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FAB7D0"
                    style="@style/Widget.AppCompat.Button.Colored"/>

            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/scheduleRecycler"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="match_parent"/>
            <Button
                android:id="@+id/btnAddLesson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+ Add Lesson"
                android:backgroundTint="#FAB7D0"
                android:textColor="#FFFFFF"
                android:layout_marginTop="4dp" />
            <Button
                android:id="@+id/btnSaveSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Changes"
                android:backgroundTint="#FAB7D0" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
