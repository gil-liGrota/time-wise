<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toolbar עם כפתור המבורגר -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#FAB7D0"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☰"
            android:textSize="28sp"
            android:textColor="@android:color/white"
            android:padding="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:paddingStart="16dp"/>
    </LinearLayout>

    <!-- תוכן + תפריט -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- תפריט צד שמאל -->
        <LinearLayout
            android:id="@+id/sideMenu"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFEAF0"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/nav_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Home"
                android:padding="8dp"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/nav_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Activity"
                android:padding="8dp"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/nav_school_schedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="School Schedule"
                android:padding="8dp"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/nav_follow_efficiency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Follow Efficiency"
                android:padding="8dp"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/nav_todo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TODO"
                android:padding="8dp"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/nav_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calendar"
                android:padding="8dp"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/nav_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notes"
                android:padding="8dp"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/nav_learning_plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Learning Plan"
                android:padding="8dp"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/nav_follow_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Follow Goal"
                android:padding="8dp"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- תוכן מרכזי -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- כפתורי ימים -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="6"
                android:gravity="center_horizontal"
                android:layout_marginBottom="8dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSun"
                    android:text="Sun"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_button_ripple"
                    android:textColor="@android:color/white"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnMon"
                    android:text="Mon"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_button_ripple"
                    android:textColor="@android:color/white"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTue"
                    android:text="Tue"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_button_ripple"
                    android:textColor="@android:color/white"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnWed"
                    android:text="Wed"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_button_ripple"
                    android:textColor="@android:color/white"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnThu"
                    android:text="Thu"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_button_ripple"
                    android:textColor="@android:color/white"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnFri"
                    android:text="Fri"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_button_ripple"
                    android:textColor="@android:color/white"/>
            </LinearLayout>

            <!-- רשימת מערכת שעות -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/scheduleRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
