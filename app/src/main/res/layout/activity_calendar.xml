<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#FAB7D0"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFEAF0"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="☰"
                android:textColor="#FAB7D0"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My Calendar"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="16dp"
                android:layout_marginEnd="40dp"
                android:textColor="#FAB7D0" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/sideMenu"
            android:layout_width="220dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFEAF0"
            android:padding="8dp"
            android:visibility="gone"
            android:elevation="8dp">

            <TextView
                android:id="@+id/nav_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏠 Home"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 Activity"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_school_schedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📚 School Schedule"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_follow_efficiency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📈 Follow Efficiency"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_todo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅ TODO"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FAB7D0"
                android:layout_margin="8dp"/>

            <TextView
                android:id="@+id/nav_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅 Calendar"
                android:padding="12dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FAB7D0"/>

            <TextView
                android:id="@+id/nav_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 Notes"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_learning_plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎓 Learning Plan"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/nav_follow_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎯 Follow Goal"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="#333333"/>
        </LinearLayout>
        <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFEAF0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">


                <CalendarView
                    android:id="@+id/calendarView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:layout_margin="8dp"
                    android:elevation="4dp" />

                <TextView
                    android:id="@+id/tvSelectedDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select a date to see tasks"
                    android:textSize="18sp"
                    android:padding="12dp"
                    android:textColor="#333333" />

                <ListView
                    android:id="@+id/lvTasksForDate"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="8dp"
                    android:padding="8dp" />
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</LinearLayout>