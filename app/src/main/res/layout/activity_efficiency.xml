<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:id="@+id/rootLayout"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:background="#FFEAF0"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/btnMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="☰"
        android:textSize="28sp"
        android:textColor="#FAB7D0"
        android:padding="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Follow Efficiency"
        android:textColor="#FAB7D0"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_marginLeft="65dp"
        android:paddingStart="16dp"/>
</LinearLayout>

<LinearLayout
    android:id="@+id/contentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/sideMenu"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFEAF0"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/nav_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏠 Home"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/nav_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Activity"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/nav_school_schedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📚 School Schedule"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FAB7D0"
            android:layout_margin="8dp"/>

        <TextView
            android:id="@+id/nav_follow_efficiency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📈 Follow Efficiency"
            android:padding="12dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FAB7D0"/>

        <TextView
            android:id="@+id/nav_todo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ TODO"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/nav_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 Calendar"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/nav_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 Notes"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/nav_follow_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎯 Follow Goal"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#333333"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FAB7D0"
            android:layout_margin="8dp"/>

        <TextView
            android:id="@+id/nav_sign_out"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SIGN OUT"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#FF5252"
            android:textStyle="bold"
            android:layout_marginBottom="0dp"
            android:gravity="center_horizontal"/>
    </LinearLayout>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFEAF0">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rate your efficiency (1-4)"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FAB7D0"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"/>

        <SeekBar
            android:id="@+id/sbRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="3"
            android:progress="1" />

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score: 2"
            android:textSize="18sp"
            android:textColor="#FAB7D0"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send Rating"
            android:backgroundTint="#FAB7D0"
            android:layout_marginTop="20dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#FAB7D0"
            android:layout_marginVertical="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Efficiency History:"
            android:textColor="#FAB7D0"
            android:textSize="18sp"
            android:textStyle="italic"/>

        <ListView
            android:id="@+id/lvEfficiencyHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</LinearLayout>
</LinearLayout>
